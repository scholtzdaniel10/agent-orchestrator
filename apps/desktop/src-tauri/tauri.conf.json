{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legate",
  "version": "0.2.0-rc.1",
  "identifier": "dev.legate.app",
  "build": {
    "beforeDevCommand": {
      "script": "dx serve --platform web --port 8080",
      "cwd": "../../ui"
    },
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": {
      "script": "dx build --release --platform web",
      "cwd": "../../ui"
    },
    "frontendDist": "../../../target/dx/legate-ui/release/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Legate",
        "width": 1400,
        "height": 820,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080 ws://127.0.0.1:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
