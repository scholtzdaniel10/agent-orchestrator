{
  "rules": {
    "planning": ["claude", "cursor"],
    "debugging": ["claude", "cursor"],
    "review": ["claude", "cursor"],
    "refactor": ["cursor", "claude"],
    "boilerplate": ["cursor", "claude"]
  },
  "fallbackFit": 0.5,
  "allowance": {
    "claude": { "windowHours": 5, "units": 15 },
    "cursor": { "windowHours": 720, "units": 20000000 }
  },
  "defaultRestHours": 5,
  "maxParallel": 3,
  "pace": {
    "weight": 1.5,
    "min": 0.5,
    "max": 2,
    "atRiskSlack": 0.25,
    "atRiskLeft": 0.15
  }
}
